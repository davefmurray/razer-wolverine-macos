Link libusb statically into libSDL2 when SDL_HIDAPI_LIBUSB_SHARED=OFF (macOS): SDL's CMake otherwise
dlopens "libusb-1.0.0.dylib" at runtime, which would require shipping a second dylib next to SDL.
--- a/cmake/sdlchecks.cmake
+++ b/cmake/sdlchecks.cmake
@@ -1237,6 +1237,10 @@
             list(APPEND EXTRA_LIBS ${PKG_LIBUSB_LIBRARIES})
           elseif(OS2)
             set(SDL_LIBUSB_DYNAMIC "\"usb100.dll\"")
+          elseif(DEFINED SDL_HIDAPI_LIBUSB_SHARED AND NOT SDL_HIDAPI_LIBUSB_SHARED)
+            # static link: libusb + the frameworks its darwin backend needs
+            list(APPEND EXTRA_LDFLAGS ${PKG_LIBUSB_LDFLAGS})
+            list(APPEND EXTRA_LIBS ${PKG_LIBUSB_LIBRARIES} objc "-Wl,-framework,IOKit" "-Wl,-framework,CoreFoundation" "-Wl,-framework,Security")
           else()
             # libusb is loaded dynamically, so don't add it to EXTRA_LIBS
             FindLibraryAndSONAME("usb-1.0" LIBDIRS ${PKG_LIBUSB_LIBRARY_DIRS})

+/*
+  GIP (Xbox One / Gaming Input Protocol) security handshake + chunked message transport for the
+  HIDAPI Xbox One driver. Ported from medusalix/xone (auth/auth.c, bus/protocol.c) to userspace,
+  using Apple CommonCrypto + Security.framework. Some licensed third-party controllers (e.g. Razer
+  Wolverine V3 Pro in Xbox mode) send no input until this handshake completes.
+*/
+#ifndef SDL_hidapi_gipauth_h_
+#define SDL_hidapi_gipauth_h_
+
+#include "../../SDL_internal.h"
+#include "SDL_hidapijoystick_c.h"
+
+#if defined(__MACOSX__) && defined(SDL_JOYSTICK_HIDAPI_XBOXONE)
+#define SDL_HIDAPI_GIP_AUTH 1
+

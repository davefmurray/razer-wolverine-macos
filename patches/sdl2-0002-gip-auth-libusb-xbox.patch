+typedef struct GIP_AuthSession GIP_AuthSession;
+
+GIP_AuthSession *GIP_Auth_Create(GIP_WriteFn write, void *user);
+void GIP_Auth_Destroy(GIP_AuthSession *s);
+int GIP_Auth_Start(GIP_AuthSession *s);                       /* sends host hello */
+/* Feed every raw packet received from the controller. Returns SDL_TRUE if the packet was consumed
+   (auth 0x06 messages, protocol-control ACKs 0x01 for our chunked sends, fragments). */
+SDL_bool GIP_Auth_HandlePacket(GIP_AuthSession *s, const Uint8 *data, int len);
+SDL_bool GIP_Auth_IsComplete(const GIP_AuthSession *s);
+SDL_bool GIP_Auth_HasFailed(const GIP_AuthSession *s);
+#endif
+
+#endif /* SDL_hidapi_gipauth_h_ */
